# flake8 does not read pyproject.toml, so its configuration lives here.
# Enforced in CI by .github/workflows/lint.yml.
[flake8]
max-line-length = 120

exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    migrations

# Codes waiting on a repo-wide `black`/`isort` pass
# E203 and W503 disagree with black by design and stay ignored permanently.
extend-ignore =
    E128,
    E203,
    E301,
    E302,
    E303,
    E305,
    E501,
    W291,
    W292,
    W293,
    W391,
    W503
